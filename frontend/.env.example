# Deixe vazio no desenvolvimento: o Next faz proxy de /api para
# API_INTERNAL_URL (veja next.config.ts).
#
# Na Vercel (front separado da API), use a URL pública da API, sem barra no
# fim. Precisa ser variável de build, então marque para os três ambientes.
NEXT_PUBLIC_API_URL=

# Só para o proxy do Next em dev/Docker. Não é usado pelo navegador.
API_INTERNAL_URL=http://127.0.0.1:8000
