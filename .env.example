# Copie para .env e preencha com os dados reais.
# No Streamlit Cloud, use Settings -> Secrets com os mesmos nomes.

EVOLUTION_BASE_URL=https://sua-evolution-api
EVOLUTION_INSTANCE=igreja-bot
EVOLUTION_APIKEY=sua-chave

# Chave global (AUTHENTICATION_API_KEY) do servidor da Evolution API.
# Necessária para criar uma instância nova por usuário (QR Code).
# Sem ela, o painel só reconecta a instância EVOLUTION_INSTANCE.
EVOLUTION_GLOBAL_APIKEY=

# Prefixo das instâncias criadas por usuário (ex.: cb-maria)
EVOLUTION_INSTANCE_PREFIX=cb-

# Login do painel. JSON com usuário -> senha:
#   APP_USERS={"lucas": "senha123", "maria": "senha456"}
# Ou com dados extras (nome/instância/admin):
#   APP_USERS={"lucas": {"senha": "senha123", "nome": "Lucas", "instancia": "igreja-bot", "admin": true}}
# "admin": true libera a pagina Usuarios, que mostra o status do WhatsApp de todos.
# Se ficar vazio, o painel funciona sem login, usando a instância padrão.
APP_USERS=

JID_GRUPO_IGREJA_FIXO=000000000000000000@g.us
NOME_GRUPO_IGREJA_FIXO=ICM - IGREJA BOA VISTA

JID_GRUPO_ZOOM=000000000000000000@g.us
NOME_GRUPO_ZOOM=ZOOM MG VALE PEDAGOGICO
