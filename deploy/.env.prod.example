# Copie para `.env` nesta pasta (`deploy/`) e preencha.
#
#   cp .env.prod.example .env
#   $EDITOR .env
#
# Nada aqui é versionado: o `.env` fica só na VPS.

# ---------------------------------------------------------------------------
# Domínios
# ---------------------------------------------------------------------------
# Aponte o DNS deste nome para o IP da VPS antes de subir (o Caddy precisa
# disso para tirar o certificado HTTPS).
API_DOMAIN=api.seudominio.com

# Origem do front na Vercel, sem barra no fim. Várias origens: separe por
# vírgula, sem espaço. Ex.: https://gestao-membros.vercel.app
CORS_ORIGINS=https://gestao-membros.vercel.app

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=checkbirthday
POSTGRES_USER=checkbirthday
# Use só letras e números: a senha entra na URL do banco (evite @ : / # ?).
POSTGRES_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
SECRET_KEY=troque-esta-chave-bem-grande
TOKEN_HORAS=168

# Login do painel, mesmo formato do .env local:
#   {"email@dominio.com": {"senha": "senha123", "nome": "Lucas", "instancia": "igreja-bot", "admin": true}}
APP_USERS=

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp)
# ---------------------------------------------------------------------------
EVOLUTION_BASE_URL=https://evolution.ideiasdev.tech
EVOLUTION_APIKEY=
EVOLUTION_GLOBAL_APIKEY=
EVOLUTION_INSTANCE=igreja-bot
EVOLUTION_INSTANCE_PREFIX=cb-

# ---------------------------------------------------------------------------
# Grupos do disparo de aniversariantes
# ---------------------------------------------------------------------------
# O backend usa JID_GRUPO_ICM/NOME_GRUPO_ICM; o script do GitHub usa
# JID_GRUPO_IGREJA_FIXO/NOME_GRUPO_IGREJA_FIXO (mesmo grupo).
JID_GRUPO_ICM=553498018995-1503451609@g.us
NOME_GRUPO_ICM=ICM - IGREJA BOA VISTA
JID_GRUPO_ZOOM=
NOME_GRUPO_ZOOM=Zoom

JID_GRUPO_IGREJA_FIXO=553498018995-1503451609@g.us
NOME_GRUPO_IGREJA_FIXO=ICM - IGREJA BOA VISTA

# ---------------------------------------------------------------------------
# Quem envia o aniversário do dia
# ---------------------------------------------------------------------------
# `false` = quem envia é o GitHub Actions (como está hoje). Neste caso o
# workflow precisa do cron ligado, e ajustes de gênero/Não enviar SMS feitos
# NO PAINEL DA VPS não chegam ao Git (publique pelo `scripts/publicar_dados.sh`
# na sua máquina).
#
# `true` = a própria API envia às 07:00 lendo o Postgres (recomendado quando a
# VPS fica ligada 24h). Aí REMOVA o `schedule` do
# `.github/workflows/disparo-diario.yml`, senão a mensagem sai duas vezes.
DISPARO_AUTOMATICO=false
DISPARO_HORA=7
DISPARO_MINUTO=0
DISPARO_FONTE=icm
